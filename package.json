{
  "name": "alchemy-agent-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "spikes"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "cd packages/agent && bun run build",
    "release": "cd packages/agent && bun run release",
    "test": "cd packages/agent && ALCHEMY_TEST_DEV=1 bun test",
    "test:cloud": "cd packages/agent && bun test",
    "test:spikes": "cd spikes && ALCHEMY_TEST_DEV=1 bun test",
    "test:spikes:cloud": "cd spikes && bun test",
    "alchemy": "bun --cwd spikes --bun alchemy",
    "dev": "bun --cwd spikes --bun alchemy dev --stage local_$USER",
    "deploy": "bun --cwd spikes --bun alchemy deploy --stage dev_$USER",
    "plan": "bun --cwd spikes --bun alchemy plan --stage dev_$USER",
    "destroy": "bun --cwd spikes --bun alchemy destroy --stage dev_$USER",
    "hello:alchemy": "bun --cwd examples/hello --bun alchemy",
    "hello:dev": "bun --cwd examples/hello --bun alchemy dev --stage local_$USER",
    "hello:deploy": "bun --cwd examples/hello --bun alchemy deploy --stage dev_$USER",
    "hello:plan": "bun --cwd examples/hello --bun alchemy plan --stage dev_$USER",
    "hello:destroy": "bun --cwd examples/hello --bun alchemy destroy --stage dev_$USER",
    "hello:check": "bun --cwd examples/hello scripts/check.ts",
    "support:deploy": "bun --cwd examples/support-desk --bun alchemy deploy --stage dev_$USER",
    "support:plan": "bun --cwd examples/support-desk --bun alchemy plan --stage dev_$USER",
    "support:destroy": "bun --cwd examples/support-desk --bun alchemy destroy --stage dev_$USER",
    "support:demo": "bun --cwd examples/support-desk scripts/demo.ts",
    "newsroom:deploy": "bun --cwd examples/newsroom --bun alchemy deploy --stage dev_$USER",
    "newsroom:destroy": "bun --cwd examples/newsroom --bun alchemy destroy --stage dev_$USER",
    "newsroom:demo": "bun --cwd examples/newsroom scripts/demo.ts",
    "newsroom:run": "bun --cwd examples/newsroom scripts/newsroom.ts",
    "newsroom:test": "cd examples/newsroom && ALCHEMY_TEST_DEV=1 bun test",
    "newsroom:test:cloud": "cd examples/newsroom && bun test",
    "refunds:deploy": "bun --cwd examples/refunds --bun alchemy deploy --stage dev_$USER",
    "refunds:destroy": "bun --cwd examples/refunds --bun alchemy destroy --stage dev_$USER",
    "refunds:demo": "cd examples/refunds && ALCHEMY_TEST_DEV=1 ALCHEMY_LOG_LEVEL=error bun test",
    "refunds:demo:cloud": "cd examples/refunds && ALCHEMY_LOG_LEVEL=error bun test"
  },
  "devDependencies": {
    "@alchemy.run/test": "2.0.0-beta.87",
    "@types/bun": "1.4.5",
    "expect-type": "1.4.0",
    "typescript": "7.0.2"
  }
}
